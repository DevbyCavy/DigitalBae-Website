# All VITE_* values are bundled into the PUBLIC JavaScript. Never put secrets (API keys,
# passwords, private tokens) here. Only public identifiers and public form endpoints belong in this file.

# Public site URL (canonical links, sitemap, social previews). No trailing slash.
VITE_SITE_URL=https://www.example.com

# Contact form endpoint that accepts a JSON POST (e.g. https://formspree.io/f/xxxxxxx).
# Contact form: a Web3Forms access key (preferred), or any JSON POST endpoint.
VITE_WEB3FORMS_KEY=
VITE_CONTACT_ENDPOINT=

# Newsletter endpoint that accepts a JSON POST with { email, name }.
VITE_NEWSLETTER_ENDPOINT=

# Analytics (choose one). Loaded only after the visitor accepts the cookie banner.
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=
